// ========================================================
// GDG LabOps – Prisma Database Schema
// Provider: Neon PostgreSQL (Serverless)
// ========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ORGANISER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
  MENTOR
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  PENDING_APPROVAL
  WAITLISTED
  REJECTED
  CANCELLED
  ATTENDED
}

enum VenueType {
  ONLINE
  OFFLINE
  HYBRID
}

enum AttendanceStatus {
  ABSENT
  ATTENDED
  EXCUSED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EvaluationType {
  COMMAND_EXIT_CODE
  STDOUT_REGEX
  FILE_CONTENT
  HTTP_PROBE
}

enum ChallengeType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  CODE_KNOWLEDGE
  GUIDED_TASK
  RESEARCH_REFLECTION
}

enum ChallengeStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum SessionStatus {
  PENDING
  PROVISIONING
  RUNNING
  STOPPING
  STOPPED
  COMPLETED
  FAILED
  TERMINATED
  EXPIRED
}

enum SubmissionStatus {
  PENDING
  PASSED
  FAILED
  ERROR
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ACHIEVEMENT
  WORKSHOP_ANNOUNCEMENT
  HELP_REQUEST_RESPONSE
  HELP_REQUEST_STATUS_CHANGED
  LAB_SESSION_STARTED
  LAB_SESSION_FAILED
  CHALLENGE_COMPLETED
  WORKSHOP_UPDATED
  REGISTRATION_STATUS_CHANGED
}

enum PresenceStatus {
  ONLINE
  IDLE
  OFFLINE
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HelpRequestCategory {
  ENVIRONMENT_NOT_LAUNCHING
  TERMINAL_NOT_WORKING
  COMMAND_ISSUE
  INSTRUCTIONS_UNCLEAR
  CONCEPTUAL_QUESTION
  OTHER
}

enum HelpRequestStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PointsTransactionType {
  EARNED
  REVERSED
  ADJUSTED
  BONUS
}

// --------------------------------------------------------
// ENTITIES
// --------------------------------------------------------

/// Core platform user supporting multi-tenant memberships and role-based access
model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  passwordHash  String?    @map("password_hash")
  avatar        String?
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?  @map("email_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  memberships         OrganisationMembership[]
  organisedWorkshops  Workshop[]               @relation("OrganisedWorkshops")
  createdTemplates    LabTemplate[]            @relation("CreatedTemplates")
  registrations       WorkshopRegistration[]
  labSessions         LabSession[]
  submissions         ChallengeSubmission[]
  progress            StudentProgress[]
  userAchievements    UserAchievement[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  createdAnnouncements WorkshopAnnouncement[] @relation("CreatedAnnouncements")
  studentHelpRequests  HelpRequest[]          @relation("StudentHelpRequests")
  assignedHelpRequests HelpRequest[]          @relation("AssignedHelpRequests")
  helpMessages         HelpRequestMessage[]   @relation("HelpMessagesSent")
  presences            WorkshopPresence[]
  activities           WorkshopActivity[]
  pointsTransactions   PointsTransaction[]
  workshopFeedbacks    WorkshopFeedback[]
  totalPoints          Int                    @default(0) @map("total_points")
  leaderboardOptOut    Boolean                @default(false) @map("leaderboard_opt_out")

  @@map("users")
}

/// Organisation / Chapter entity (e.g., GDG on Campus Silicon Valley)
model Organisation {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?  @db.Text
  logo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  members            OrganisationMembership[]
  workshops          Workshop[]
  labTemplates       LabTemplate[]
  auditLogs          AuditLog[]
  achievements       Achievement[]
  pointsTransactions PointsTransaction[]

  @@map("organisations")
}

/// Junction entity connecting users to organisations with roles
model OrganisationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganisationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  status         MembershipStatus @default(ACTIVE)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId], name: "unique_organisation_user")
  @@index([userId])
  @@index([organisationId])
  @@map("organisation_memberships")
}

/// Workshop session managed by organisers under an organisation
model Workshop {
  id                   String         @id @default(uuid()) @db.Uuid
  organisationId       String         @map("organisation_id") @db.Uuid
  organiserId          String         @map("organiser_id") @db.Uuid
  title                String
  slug                 String         @unique
  shortDescription     String?        @map("short_description")
  description          String         @db.Text
  domain               String
  difficulty           Difficulty     @default(BEGINNER)
  bannerUrl            String?        @map("banner_url")
  tags                 String[]       @default([])

  // Schedule & Venue
  startDate            DateTime       @map("start_date")
  endDate              DateTime       @map("end_date")
  duration             Int            // in minutes
  timezone             String         @default("UTC")
  venueType            VenueType      @default(ONLINE) @map("venue_type")
  venueAddress         String?        @map("venue_address") // URL or address

  // Speaker / Instructor
  instructorName       String?        @map("instructor_name")
  instructorBio        String?        @map("instructor_bio") @db.Text

  // Registration Policies
  registrationOpensAt  DateTime?      @map("registration_opens_at")
  registrationDeadline DateTime       @map("registration_deadline")
  participantLimit     Int            @default(50) @map("participant_limit")
  requiresApproval     Boolean        @default(false) @map("requires_approval")
  isPublic             Boolean        @default(true) @map("is_public")
  codeJoinEnabled      Boolean        @default(true) @map("code_join_enabled")
  registrationCode     String         @unique @map("registration_code")

  status               WorkshopStatus @default(DRAFT)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organiser    User         @relation("OrganisedWorkshops", fields: [organiserId], references: [id], onDelete: Restrict)

  registrations        WorkshopRegistration[]
  workshopLabs         WorkshopLab[]
  labSessions          LabSession[]
  studentProgress      StudentProgress[]
  challengeSubmissions ChallengeSubmission[]
  presences            WorkshopPresence[]
  announcements        WorkshopAnnouncement[]
  helpRequests         HelpRequest[]
  activities           WorkshopActivity[]
  outboxEvents         RealtimeEventOutbox[]
  feedbacks            WorkshopFeedback[]
  pointsTransactions   PointsTransaction[]

  @@index([registrationCode])
  @@index([status])
  @@index([organisationId])
  @@index([organiserId])
  @@map("workshops")
}

/// Student enrollment in a workshop
model WorkshopRegistration {
  id               String             @id @default(uuid()) @db.Uuid
  workshopId       String             @map("workshop_id") @db.Uuid
  studentId        String             @map("student_id") @db.Uuid
  registeredAt     DateTime           @default(now()) @map("registered_at")
  status           RegistrationStatus @default(REGISTERED)
  attendanceStatus AttendanceStatus   @default(ABSENT) @map("attendance_status")
  notes            String?            @db.Text
  approvedAt       DateTime?          @map("approved_at")
  cancelledAt      DateTime?          @map("cancelled_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([workshopId, studentId], name: "unique_workshop_student_registration")
  @@index([workshopId])
  @@index([studentId])
  @@index([status])
  @@map("workshop_registrations")
}

/// Reusable lab template environment specifications
model LabTemplate {
  id                 String         @id @default(uuid()) @db.Uuid
  organisationId     String         @map("organisation_id") @db.Uuid
  createdBy          String         @map("created_by") @db.Uuid
  name               String
  shortDescription   String?        @map("short_description")
  description        String         @db.Text
  domain             String
  difficulty         Difficulty     @default(INTERMEDIATE)
  estimatedDuration  Int            @map("estimated_duration") // in minutes
  coverImageUrl      String?        @map("cover_image_url")
  tags               String[]       @default([])
  requiredTools      Json?          @map("required_tools")
  version            Int            @default(1)
  environmentType    String         @default("terminal") @map("environment_type")
  environmentProfile String         @default("ubuntu-fundamentals") @map("environment_profile")
  learningObjectives Json           @map("learning_objectives")
  prerequisites      Json
  status             TemplateStatus @default(PUBLISHED)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  creator      User         @relation("CreatedTemplates", fields: [createdBy], references: [id], onDelete: Restrict)

  workshopLabs    WorkshopLab[]
  challenges      Challenge[]
  labSessions     LabSession[]
  studentProgress StudentProgress[]
  helpRequests    HelpRequest[]

  @@index([organisationId])
  @@index([domain])
  @@index([status])
  @@map("lab_templates")
}

/// Junction enabling workshops to incorporate multiple reusable lab templates
model WorkshopLab {
  id            String    @id @default(uuid()) @db.Uuid
  workshopId    String    @map("workshop_id") @db.Uuid
  labTemplateId String    @map("lab_template_id") @db.Uuid
  displayOrder  Int       @default(1) @map("display_order")
  isRequired    Boolean   @default(true) @map("is_required")
  availableFrom DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")
  labSnapshot   Json?     @map("lab_snapshot") // Immutable snapshot of template + challenges at time of attachment

  workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labTemplate LabTemplate @relation(fields: [labTemplateId], references: [id], onDelete: Restrict)

  @@unique([workshopId, labTemplateId], name: "unique_workshop_lab_template")
  @@index([workshopId])
  @@index([labTemplateId])
  @@map("workshop_labs")
}

/// Individual challenge milestone attached to a lab template
model Challenge {
  id                String          @id @default(uuid()) @db.Uuid
  labTemplateId     String          @map("lab_template_id") @db.Uuid
  title             String
  description       String          @db.Text
  instructions      String          @db.Text
  challengeType     ChallengeType   @default(MULTIPLE_CHOICE) @map("challenge_type")
  difficulty        Difficulty      @default(INTERMEDIATE)
  points            Int             @default(100)
  timeLimit         Int?            @map("time_limit") // in minutes
  displayOrder      Int             @default(1) @map("display_order")
  hints             Json?           // Array of hint items [{ id, orderIndex, content, penaltyPercent }]
  referenceMaterial String?         @db.Text @map("reference_material")
  solutionData      Json?           @map("solution_data") // Hidden correct answers, rules, checklist (server-side only)
  explanation       String?         @db.Text // Post-completion explanation
  evaluationType    EvaluationType  @default(COMMAND_EXIT_CODE) @map("evaluation_type")
  status            ChallengeStatus @default(ACTIVE)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  labTemplate LabTemplate           @relation(fields: [labTemplateId], references: [id], onDelete: Cascade)
  tasks       ChallengeTask[]
  submissions ChallengeSubmission[]
  helpRequests HelpRequest[]

  @@index([labTemplateId])
  @@map("challenges")
}

/// Predefined evaluation task within a challenge (strictly no raw shell scripts stored)
model ChallengeTask {
  id               String @id @default(uuid()) @db.Uuid
  challengeId      String @map("challenge_id") @db.Uuid
  title            String
  description      String @db.Text
  taskType         String @map("task_type") // e.g. "FILE_CHECK", "PROCESS_CHECK", "PORT_CHECK"
  evaluationConfig Json   @map("evaluation_config") // Predefined assertions schema
  points           Int    @default(50)
  displayOrder     Int    @default(1) @map("display_order")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("challenge_tasks")
}

/// Active or historical container sandbox session for a student
model LabSession {
  id                 String        @id @default(uuid()) @db.Uuid
  studentId          String        @map("student_id") @db.Uuid
  workshopId         String        @map("workshop_id") @db.Uuid
  labTemplateId      String        @map("lab_template_id") @db.Uuid
  status             SessionStatus @default(PENDING)
  containerReference String?       @map("container_reference") // Internal Docker ID, shielded from clients
  accessUrl          String?       @map("access_url")          // Short-lived signed proxy gateway URL
  runnerUrl          String?       @map("runner_url")
  runnerId           String?       @map("runner_id")
  environmentProfile String?       @map("environment_profile")
  sessionToken       String?       @unique @map("session_token")
  connectionTicket   String?       @map("connection_ticket")
  ticketExpiresAt    DateTime?     @map("ticket_expires_at")
  lastActivityAt     DateTime?     @map("last_activity_at")
  startedAt          DateTime?     @map("started_at")
  stoppedAt          DateTime?     @map("stopped_at")
  expiresAt          DateTime?     @map("expires_at")
  terminatedAt       DateTime?     @map("terminated_at")
  terminationReason  String?       @map("termination_reason")
  failureReason      String?       @map("failure_reason")
  resourceLimits     Json?         @map("resource_limits")
  createdAt          DateTime      @default(now()) @map("created_at")

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labTemplate LabTemplate @relation(fields: [labTemplateId], references: [id], onDelete: Restrict)

  submissions ChallengeSubmission[]
  events      SessionEvent[]
  metrics     ResourceUsageMetric[]

  @@index([studentId])
  @@index([workshopId])
  @@index([status])
  @@index([sessionToken])
  @@map("lab_sessions")
}

/// Audit log of container lifecycle and connection events
model SessionEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  eventType String   @map("event_type")
  message   String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session LabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@map("session_events")
}

/// Periodic telemetry snapshots of container resource consumption
model ResourceUsageMetric {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  cpuPercent    Float    @default(0) @map("cpu_percent")
  memoryUsageMb Float    @default(0) @map("memory_usage_mb")
  pidsCount     Int      @default(0) @map("pids_count")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  session LabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([recordedAt])
  @@map("resource_usage_metrics")
}

/// Submission and automated grading record
model ChallengeSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  challengeId    String           @map("challenge_id") @db.Uuid
  workshopId     String?          @map("workshop_id") @db.Uuid
  labSessionId   String?          @map("lab_session_id") @db.Uuid
  submissionData Json             @map("submission_data")
  score          Int              @default(0)
  status         SubmissionStatus @default(PENDING)
  feedback       String?          @db.Text
  pointsAwarded  Int              @default(0) @map("points_awarded")
  submittedAt    DateTime         @default(now()) @map("submitted_at")
  evaluatedAt    DateTime?        @map("evaluated_at")

  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challenge  Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  labSession LabSession? @relation(fields: [labSessionId], references: [id], onDelete: Cascade)
  workshop   Workshop?   @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([challengeId])
  @@index([workshopId])
  @@index([labSessionId])
  @@map("challenge_submissions")
}

/// Cumulative progress tracker per student for a given workshop and lab
model StudentProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  studentId            String    @map("student_id") @db.Uuid
  workshopId           String    @map("workshop_id") @db.Uuid
  labTemplateId        String    @map("lab_template_id") @db.Uuid
  completedChallenges  Int       @default(0) @map("completed_challenges")
  totalChallenges      Int       @default(0) @map("total_challenges")
  totalPoints          Int       @default(0) @map("total_points")
  completionPercentage Float     @default(0.0) @map("completion_percentage")
  challengeProgress    Json?     @map("challenge_progress") // Map of challengeId -> { status, score, attempts, completedAt }
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labTemplate LabTemplate @relation(fields: [labTemplateId], references: [id], onDelete: Restrict)

  @@unique([studentId, workshopId, labTemplateId], name: "unique_student_workshop_lab_progress")
  @@index([studentId])
  @@index([workshopId])
  @@map("student_progress")
}

/// Catalog of achievement badges
model Achievement {
  id             String            @id @default(uuid()) @db.Uuid
  slug           String            @unique
  name           String
  description    String
  icon           String
  category       String
  points         Int               @default(50)
  criteria       Json?
  badgeUrl       String?           @map("badge_url")
  organisationId String?           @map("organisation_id") @db.Uuid
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")

  organisation     Organisation?     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userAchievements UserAchievement[]

  @@index([organisationId])
  @@index([slug])
  @@map("achievements")
}

/// Junction tracking which achievements a user has earned
model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  awardedAt     DateTime @default(now()) @map("awarded_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId], name: "unique_user_achievement")
  @@index([userId])
  @@map("user_achievements")
}

/// User notification inbox
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// Sanitized operational audit trails
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json?    // Sanitized: never passwords, tokens, or shell secrets
  createdAt      DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organisationId])
  @@index([resourceType])
  @@map("audit_logs")
}

/// Cryptographically hashed single-use password reset tokens
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

/// Single-use email verification tokens
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verification_tokens")
}

/// Real-time presence tracking per workshop participant
model WorkshopPresence {
  id             String         @id @default(uuid()) @db.Uuid
  workshopId     String         @map("workshop_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  status         PresenceStatus @default(ONLINE)
  clientCount    Int            @default(1) @map("client_count")
  lastHeartbeat  DateTime       @default(now()) @map("last_heartbeat")
  connectedAt    DateTime       @default(now()) @map("connected_at")
  disconnectedAt DateTime?      @map("disconnected_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId], name: "unique_workshop_user_presence")
  @@index([workshopId, status])
  @@index([userId])
  @@map("workshop_presences")
}

/// Broadcast and scheduled announcements from workshop organisers
model WorkshopAnnouncement {
  id           String               @id @default(uuid()) @db.Uuid
  workshopId   String               @map("workshop_id") @db.Uuid
  createdById  String               @map("created_by_id") @db.Uuid
  title        String
  message      String               @db.Text
  priority     AnnouncementPriority @default(NORMAL)
  status       AnnouncementStatus   @default(PUBLISHED)
  isPinned     Boolean              @default(false) @map("is_pinned")
  targetGroup  String?              @map("target_group")
  publishedAt  DateTime             @default(now()) @map("published_at")
  scheduledAt  DateTime?            @map("scheduled_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  author   User     @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workshopId, publishedAt])
  @@index([isPinned])
  @@map("workshop_announcements")
}

/// Structured student assistance requests during live labs
model HelpRequest {
  id                   String              @id @default(uuid()) @db.Uuid
  workshopId           String              @map("workshop_id") @db.Uuid
  studentId            String              @map("student_id") @db.Uuid
  labTemplateId        String?             @map("lab_template_id") @db.Uuid
  challengeId          String?             @map("challenge_id") @db.Uuid
  category             HelpRequestCategory @default(OTHER)
  description          String              @db.Text
  status               HelpRequestStatus   @default(OPEN)
  assignedOrganiserId  String?             @map("assigned_organiser_id") @db.Uuid
  resolutionNotes      String?             @db.Text @map("resolution_notes")
  resolvedAt           DateTime?           @map("resolved_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  workshop          Workshop             @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  student           User                 @relation("StudentHelpRequests", fields: [studentId], references: [id], onDelete: Cascade)
  assignedOrganiser User?                @relation("AssignedHelpRequests", fields: [assignedOrganiserId], references: [id], onDelete: SetNull)
  labTemplate       LabTemplate?         @relation(fields: [labTemplateId], references: [id], onDelete: SetNull)
  challenge         Challenge?           @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  messages          HelpRequestMessage[]

  @@index([workshopId, status])
  @@index([studentId])
  @@index([assignedOrganiserId])
  @@map("help_requests")
}

/// Threaded messages exchanged between student and organiser on a help request
model HelpRequestMessage {
  id            String   @id @default(uuid()) @db.Uuid
  helpRequestId String   @map("help_request_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  senderRole    Role     @default(STUDENT) @map("sender_role")
  message       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  helpRequest HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  sender      User        @relation("HelpMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([helpRequestId, createdAt])
  @@map("help_request_messages")
}

/// Chronological immutable workshop activity timeline
model WorkshopActivity {
  id              String   @id @default(uuid()) @db.Uuid
  workshopId      String   @map("workshop_id") @db.Uuid
  eventType       String   @map("event_type")
  actorId         String?  @map("actor_id") @db.Uuid
  relatedEntityId String?  @map("related_entity_id")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workshopId, createdAt])
  @@index([eventType])
  @@map("workshop_activities")
}

/// Transactional outbox pattern for reliable event distribution and replay
model RealtimeEventOutbox {
  id           String    @id @default(uuid()) @db.Uuid
  workshopId   String    @map("workshop_id") @db.Uuid
  eventType    String    @map("event_type")
  targetUserId String?   @map("target_user_id") @db.Uuid
  payload      Json
  createdAt    DateTime  @default(now()) @map("created_at")
  deliveredAt  DateTime? @map("delivered_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId, createdAt])
  @@index([targetUserId])
  @@map("realtime_event_outbox")
}

/// Append-only transactional ledger for gamification points
model PointsTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  organisationId String?               @map("organisation_id") @db.Uuid
  workshopId     String?               @map("workshop_id") @db.Uuid
  challengeId    String?               @map("challenge_id") @db.Uuid
  amount         Int                   // positive for earned, negative for reversals
  type           PointsTransactionType @default(EARNED)
  reason         String
  sourceActivity String                @map("source_activity") // e.g. "CHALLENGE_COMPLETION", "LAB_COMPLETION", "WORKSHOP_ATTENDANCE", "BONUS"
  referenceId    String?               @map("reference_id")    // e.g. submissionId, registrationId, txId
  idempotencyKey String                @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  workshop     Workshop?     @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workshopId])
  @@index([organisationId])
  @@map("points_transactions")
}

/// Structured student feedback collected after workshop participation
model WorkshopFeedback {
  id                       String   @id @default(uuid()) @db.Uuid
  workshopId               String   @map("workshop_id") @db.Uuid
  studentId                String   @map("student_id") @db.Uuid
  contentRating            Int      @default(5) @map("content_rating") // 1-5
  instructorRating         Int      @default(5) @map("instructor_rating") // 1-5
  labQualityRating         Int      @default(5) @map("lab_quality_rating") // 1-5
  platformExperienceRating Int      @default(5) @map("platform_experience_rating") // 1-5
  overallRating            Float    @default(5.0) @map("overall_rating") // 1-5
  comments                 String?  @db.Text
  suggestions              String?  @db.Text
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([workshopId, studentId], name: "unique_workshop_student_feedback")
  @@index([workshopId])
  @@index([studentId])
  @@map("workshop_feedbacks")
}
