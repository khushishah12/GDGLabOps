# ========================================================
# GDG LabOps – Environment Variables Configuration (.env.example)
# ========================================================

# Neon PostgreSQL Connection Strings
# 1. DATABASE_URL: Pooled connection string (PgBouncer) for standard Next.js queries
DATABASE_URL="postgresql://neondb_owner:npg_samplepassword@ep-bold-snowflake-a5sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL: Direct unpooled connection string required by Prisma for migrations and DDL operations
DIRECT_URL="postgresql://neondb_owner:npg_samplepassword@ep-bold-snowflake-a5sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Next.js Environment & Security
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="gdg-labops-development-secret-32-bytes-minimum"
NEXTAUTH_URL="http://localhost:3000"

# Execution Plane Daemon Integration (For future phase)
WORKER_DAEMON_SECRET="gdg-labops-daemon-hmac-shared-cluster-key"
